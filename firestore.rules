rules_version = '2';

// One operator/admin role: anyone who can sign in (accounts are created manually
// in the Firebase console) has full access to the business data. Everything else
// is denied. Money and order documents are also checked for sane shapes, so a bug
// or typo can't store a text amount or a negative payment.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ---- business data ----------------------------------------------------
    match /clients/{id} {
      allow read, delete: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
    }

    match /sales_orders/{id} {
      allow read, delete: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.client_id is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
    }

    match /payments/{id} {
      allow read, delete: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.client_id is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.method in ['cash', 'bkash', 'bank', 'other']
        && request.resource.data.date is string;
    }

    // Audit trail: can be added to and read, but never changed or removed.
    match /activity_log/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.action is string;
      allow update, delete: if false;
    }

    match /staff_payments/{id} {
      allow read, delete: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.worker_id is string
        && request.resource.data.type in ['advance', 'salary']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is string;
    }

    match /expenses/{id} {
      allow read, delete: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is string;
    }

    // ---- production data (unchanged behaviour) -----------------------------
    match /workers/{id} { allow read, write: if isSignedIn(); }
    match /machines/{id} { allow read, write: if isSignedIn(); }
    match /products/{id} { allow read, write: if isSignedIn(); }
    match /production_logs/{id} { allow read, write: if isSignedIn(); }
    // Production queue (the original "orders" collection, kept as-is so existing data survives)
    match /orders/{id} { allow read, write: if isSignedIn(); }

    // Settings and the order-number counter
    match /app_config/{docId} { allow read, write: if isSignedIn(); }

    // Used by the in-app connection check; not real data.
    match /_diagnostics/{docId} { allow read, write: if isSignedIn(); }

    // Deny everything else by default.
    match /{document=**} { allow read, write: if false; }
  }
}
